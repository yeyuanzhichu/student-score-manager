<%@ page pageEncoding="UTF-8" %>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<c:set var="user" value="${sessionScope.currentUser}"/>
<c:set var="active" value="${empty activeNav ? pageContext.request.servletPath : activeNav}"/>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><c:out value="${pageTitle}"/> · 智汇成绩</title>
<link rel="icon" href="${ctx}/assets/img/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="${ctx}/assets/css/app.css">
</head>
<body>
<svg class="icon-sprite" aria-hidden="true">
  <symbol id="icon-dashboard" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></symbol>
  <symbol id="icon-scores" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></symbol>
  <symbol id="icon-students" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></symbol>
  <symbol id="icon-courses" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></symbol>
  <symbol id="icon-reports" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></symbol>
  <symbol id="icon-logout" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></symbol>
  <symbol id="icon-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></symbol>
  <symbol id="icon-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></symbol>
  <symbol id="icon-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></symbol>
  <symbol id="icon-edit" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.83 2.83 0 0 1 4 4L7.5 20.5 2 22l1.5-5.5z"/></symbol>
  <symbol id="icon-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></symbol>
  <symbol id="icon-arrow-left" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></symbol>
  <symbol id="icon-user" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></symbol>
  <symbol id="icon-phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></symbol>
  <symbol id="icon-calendar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></symbol>
  <symbol id="icon-print" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></symbol>
  <symbol id="icon-download" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></symbol>
  <symbol id="icon-award" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M15.5 13l1 8-4.5-3-4.5 3 1-8"/></symbol>
  <symbol id="icon-book" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></symbol>
  <symbol id="icon-clipboard" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1"/></symbol>
</svg>

<div class="app-shell">
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <div class="brand-logo">智</div>
      <div>
        <div class="brand-name">智汇成绩</div>
        <div class="brand-sub">班级学生成绩管理系统</div>
      </div>
    </div>

    <nav class="sidebar-nav">
      <c:choose>
        <c:when test="${user.teacher}">
          <div class="nav-section-label">教务管理</div>
          <a class="nav-link ${active eq '/teacher/dashboard' ? 'active' : ''}" href="${ctx}/teacher/dashboard">
            <svg class="icon"><use href="#icon-dashboard"/></svg><span>工作台</span>
          </a>
          <a class="nav-link ${active eq '/teacher/scores' ? 'active' : ''}" href="${ctx}/teacher/scores">
            <svg class="icon"><use href="#icon-scores"/></svg><span>成绩录入</span>
          </a>
          <a class="nav-link ${active eq '/teacher/students' ? 'active' : ''}" href="${ctx}/teacher/students">
            <svg class="icon"><use href="#icon-students"/></svg><span>学生管理</span>
          </a>
          <a class="nav-link ${active eq '/teacher/courses' ? 'active' : ''}" href="${ctx}/teacher/courses">
            <svg class="icon"><use href="#icon-courses"/></svg><span>课程管理</span>
          </a>
          <a class="nav-link ${active eq '/teacher/reports' ? 'active' : ''}" href="${ctx}/teacher/reports">
            <svg class="icon"><use href="#icon-reports"/></svg><span>统计分析</span>
          </a>
        </c:when>
        <c:otherwise>
          <div class="nav-section-label">我的学习</div>
          <a class="nav-link ${active eq '/student/dashboard' ? 'active' : ''}" href="${ctx}/student/dashboard">
            <svg class="icon"><use href="#icon-book"/></svg><span>我的成绩</span>
          </a>
        </c:otherwise>
      </c:choose>
    </nav>

    <div class="sidebar-foot">
      <div class="sidebar-user">
        <div class="avatar">${fn:substring(user.displayName, 0, 1)}</div>
        <div>
          <div class="sidebar-user-name"><c:out value="${user.displayName}"/></div>
          <div class="sidebar-user-role">${user.teacher ? '教师' : '学生'}</div>
        </div>
      </div>
      <a class="btn-logout" href="${ctx}/logout">
        <svg class="icon" style="width:16px;height:16px"><use href="#icon-logout"/></svg>退出登录
      </a>
    </div>
  </aside>

  <div class="sidebar-scrim" id="sidebarScrim"></div>

  <main class="main">
    <header class="topbar">
      <button class="icon-btn menu-btn" id="menuBtn" aria-label="打开菜单">
        <svg class="icon"><use href="#icon-menu"/></svg>
      </button>
      <div class="topbar-titles">
        <h1><c:out value="${pageTitle}"/></h1>
        <p><c:out value="${pageSubtitle}"/></p>
      </div>
      <div class="topbar-right">
        <span class="date-chip" id="dateChip"></span>
        <div class="topbar-user">
          <div class="avatar">${fn:substring(user.displayName, 0, 1)}</div>
          <div class="meta">
            <div class="name"><c:out value="${user.displayName}"/></div>
            <div class="role">${user.teacher ? '教师' : '学生'}</div>
          </div>
        </div>
      </div>
    </header>

    <div class="content">
      <c:if test="${not empty sessionScope.flashSuccess}">
        <div class="alert alert-success" role="alert">
          <c:out value="${sessionScope.flashSuccess}"/>
          <button type="button" class="alert-close" aria-label="关闭">&times;</button>
        </div>
        <c:remove var="flashSuccess" scope="session"/>
      </c:if>
      <c:if test="${not empty sessionScope.flashError}">
        <div class="alert alert-error" role="alert">
          <c:out value="${sessionScope.flashError}"/>
          <button type="button" class="alert-close" aria-label="关闭">&times;</button>
        </div>
        <c:remove var="flashError" scope="session"/>
      </c:if>
